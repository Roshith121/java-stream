
import java.util.List;
import java.util.stream.Collectors;

public class StreamPractice {

    public static void main(String[] args) {
        List<String> names = List.of("Roshith","Om","Jijay","Vj");
        names.stream().filter(e->e.length()>3).map(e->e.toUpperCase()).forEach(e->System.out.println(e));
    }
}
